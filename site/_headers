/*
X-Frame-Options: SAMEORIGIN
X-Content-Type-Options: nosniff
Strict-Transport-Security: max-age=31536000; includeSubDomains
Referrer-Policy: same-origin
Permissions-Policy: geolocation=(self), camera=(self), microphone=(self)
Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; media-src 'self' data: https:; connect-src 'self' https://api.mymemory.translated.net https://www.bing.com; font-src 'self' data:; frame-src 'self' https:; frame-ancestors 'self'; object-src 'none'; base-uri 'self'
/uploads/*
  Cache-Control: public, max-age=86400
/assets/*
  Cache-Control: public, max-age=604800, immutable
/
  Cache-Control: no-cache, must-revalidate
/index.html
  Cache-Control: no-cache, must-revalidate
/kbchat.apk
  Cache-Control: no-store, must-revalidate
